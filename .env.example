# ===== Backend (FastAPI) =====
# Port the FastAPI server listens on
API_PORT=8000

# Optional: host to bind (use 127.0.0.1 for local only)
API_HOST=127.0.0.1

# Path to the SQLite database file (created automatically)
DATABASE_PATH=backend/demo.db

# ===== Frontend (Next.js) =====
# Base URL of the FastAPI backend. The frontend uses this to call the API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ===== Model =====
# Directory where trained ML artifacts are stored
ML_ARTIFACTS_DIR=ml/artifacts
ML_FIGURES_DIR=ml/figures

# ===== Demo mode =====
# Always on for this prototype. When true, the UI shows:
# "DEMO DATA - NOT FOR REAL-WORLD HEALTHCARE DECISIONS"
DEMO_MODE=true